{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Terrapolis",
  "version": "0.3.3",
  "identifier": "com.custom.mclauncher",
  "mainBinaryName": "Terrapolis",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Terrapolis",
        "width": 1100,
        "height": 690,
        "resizable": true,
        "center": true,
        "minWidth": 980,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "hodiw1",
    "copyright": "Copyright © 2026 hodiw1. Terrapolis Minecraft Launcher.",
    "shortDescription": "Terrapolis Minecraft Launcher",
    "longDescription": "Terrapolis — лаунчер Minecraft для збірок проєкту Terrapolis.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Ukrainian", "English"]
      }
    }
  }
}
